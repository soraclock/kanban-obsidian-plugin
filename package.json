{
  "name": "kanban-obsidian-plugin",
  "version": "0.6.2",
  "description": "Obsidian plugin for personal kanban task board backed by vault Markdown files (one task = one file, frontmatter-based).",
  "license": "MIT",
  "main": "main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soraclock/kanban-obsidian-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/soraclock/kanban-obsidian-plugin/issues"
  },
  "homepage": "https://github.com/soraclock/kanban-obsidian-plugin#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "gray-matter": "^4.0.3",
    "js-sha256": "^0.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "js-yaml": "^4.1.1",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.0"
  }
}
